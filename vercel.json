{
  "regions": ["icn1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/route/:match*",
      "destination": "/api/route"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
